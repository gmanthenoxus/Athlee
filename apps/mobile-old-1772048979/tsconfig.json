{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@athlehub/shared": ["../../packages/shared/index.ts"],
      "@athlee/shared": ["../../packages/shared/index.ts"],
      "@athlee/ui": ["../../packages/ui/index.ts"]
    }
